{
  "name": "monokit",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "runServices": [
    "install",
    "db",
    "api",
    "web",
    "workspace"
  ],
  "workspaceFolder": "/repo",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    3000,
    3001,
    5432
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      }
    }
  }
}
