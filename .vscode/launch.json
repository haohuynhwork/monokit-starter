{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: api",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/repo",
      "restart": true,
      "smartStep": false,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
{
      "name": "Debug API",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/api/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/apps/api/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Docker: web (server)",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "address": "localhost",
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/repo",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Docker: migrate",
      "type": "node",
      "request": "attach",
      "port": 9232,
      "address": "localhost",
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/repo",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "web (browser)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3002",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ],
  "compounds": [
    {
      "name": "Docker: api + web",
      "configurations": [
        "Docker: api",
        "Docker: web (server)"
      ]
    }
  ]
}
