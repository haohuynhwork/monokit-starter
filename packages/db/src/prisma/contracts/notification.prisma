// use prisma-8

// Schema notes and rationale: ideas/notification/index.md
// In-app only for now; preferences and the email outbox come later.

model Notification {
  id          BigInt            @id @default(autoincrement())
  recipientId BigInt
  recipient   User              @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // What happened, e.g. 'post.published'; allowed values and their data
  // shape are checked in the domain
  type        Varchar(64)
  // Facts to render it from, not rendered text: {"postId": "5", ...}
  data        Jsonb
  // Who caused it; NULL for the system
  actorId     BigInt?
  actor       User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt   TimestamptzString @default(now())
  // NULL means unread
  readAt      TimestamptzString?

  // The bell: newest first per recipient, and the unread count
  @@index([recipientId, createdAt])
  @@index([recipientId], where: sql`("readAt" IS NULL)`, name: "notifications_unread")
  @@index([actorId])
}
