# Pinned: node 26.12.1 segfaults with pnpm 12.15
FROM node:26.12.0-slim
# procps provides `ps`, which nest --watch needs to kill the old process on reload
RUN apt-get update && apt-get install -y --no-install-recommends procps git && rm -rf /var/lib/apt/lists/*
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN npm i -g pnpm@12.15.0
WORKDIR /repo
