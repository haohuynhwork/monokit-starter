# Copy to .env and fill in. Read by compose.yaml (dev) and compose.prod.yaml (prod).

# --- Project ---
PROJECT_NAME=monokit

# --- Database (Postgres) ---
POSTGRES_USER=app
# Required in prod; compose refuses to start without it.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# Host port for Postgres (dev only; prod does not publish it).
DB_PORT=5432

# --- API (NestJS) ---
# Host port mapped to the API container (container always listens on 3001).
API_PORT=3000
# Path all api routes are mounted under, e.g. /api (GET / stays at the root).
# The web app adds it to its api calls; empty serves routes from the root.
API_PREFIX=/api
# Signs access and refresh tokens (HS256), at least 32 characters.
# Generate one with: openssl rand -base64 48
# To rotate: move the current value to JWT_SECRET_PREVIOUS, set a new one,
# restart; remove JWT_SECRET_PREVIOUS after 30 days. After a leak, replace
# JWT_SECRET and leave JWT_SECRET_PREVIOUS unset (signs everyone out).
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# JWT_SECRET_PREVIOUS=
# Mail queue (BullMQ on Valkey): valkey://, or valkeys:// for TLS (redis://
# and rediss:// work too). Unset: email is sent in the request, without
# retries. Prod compose defaults it to its valkey service
# (valkey://:$VALKEY_PASSWORD@valkey:6379); set it here to use another
# server. With a password: valkey://:password@localhost:6379
VALKEY_URL=valkey://localhost:6379
# Start of every BullMQ key in Valkey ('<prefix>:mail:...'); give each app
# sharing a Valkey its own. Letters, digits, _ . - only. Unset: 'bull'.
# Changing it orphans jobs still queued under the old prefix.
BULLMQ_PREFIX=bull
# Host port for Valkey (dev only; prod does not publish it).
VALKEY_PORT=6379
# The valkey service's password. Required in prod; empty in dev = none.
# Generate one with: openssl rand -base64 32 (URL-encode it in VALKEY_URL)
# VALKEY_PASSWORD=
# Memory cap for the valkey service, e.g. 256mb; 0 = none. Queued mail is
# never evicted: at the cap, new emails fail to queue instead.
# VALKEY_MAXMEMORY=
# The app's root secret, at least 32 characters. Each use derives its own
# key from it with a label (HKDF), e.g. encrypting secret settings in the
# database (mail password, api keys). Generate: openssl rand -base64 48
# Without it the api runs, but settings with secrets can't be saved.
# To rotate: move the current value to APP_SECRET_PREVIOUS, set a new one,
# restart (the api re-encrypts every stored secret on start and logs it),
# then remove APP_SECRET_PREVIOUS and restart again. Losing both values
# means re-entering those settings.
APP_SECRET=change-me-to-another-long-random-string-of-32-chars
# APP_SECRET_PREVIOUS=
# Web origins allowed to open the api's realtime socket (comma separated).
# Empty allows any; the socket still needs a ticket from POST /auth/ws-ticket.
# WEB_ORIGINS=http://localhost:3002
# Addresses whose X-Forwarded-For the api believes (Express "trust proxy"):
# the web server and any reverse proxy in front of the api. Rate limits key
# on the visitor address it yields. Default: loopback, uniquelocal
# TRUST_PROXY=
# Where uploaded files are stored in development (LocalStorage).
# Relative paths are from apps/api. Default: storage
# STORAGE_DIR=
# Days to keep audit log rows (who did what, with IP and user agent: personal
# data); a daily job deletes older ones. Default: 365
# AUDIT_RETENTION_DAYS=
# Password for every user `make seed` creates (admin@, editor@, author@example.com)
SEED_PASSWORD=change-me-please
# API docs at /docs and the GraphQL explorer at /graphql; on unless
# NODE_ENV=production. true/false forces it.
# SWAGGER=

# --- Web (TanStack Start: site + /admin) ---
# Dev server port (make dev:web) and host port of the web container.
# Dev and prod both proxy /api, /serve, /assets and /socket.io to the api.
WEB_PORT=3002
# The web app's public URL. The api uses it for links in emails (password
# reset) and file URLs. Empty serves from the root of the current origin,
# but then no reset emails are sent.
PUBLIC_WEB_URL=http://localhost:3002
# URL browsers use to reach the API: the origin only, without API_PREFIX
# (the realtime socket is unprefixed; the api adds the prefix where it
# reports routes). Required in prod; the api reports it at GET /.
PUBLIC_API_URL=http://localhost:3000
